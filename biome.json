{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "maxSize": 4194304,
    "includes": [
      "**",
      "!.claude",
      "!.agents",
      "!infra/worker",
      "!infra/docker-compose.yml",
      "!infra/Caddyfile",
      "!tsconfig.wmill.json",
      "!node_modules",
      "!rt.d.ts",
      "!wmill-lock.yaml",
      "!**/*.md",
      "!**/*.yaml",
      "!**/*.yml"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "noUnsafeTypeAssertion": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "jsxRuntime": "reactClassic"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["console/src/lib/writeNotices.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "usePlaywrightValidDescribeCallback": "off"
          }
        }
      }
    },
    {
      "includes": ["console/**"],
      "javascript": {
        "jsxRuntime": "transparent"
      },
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "error",
            "noGlobalEval": "error"
          }
        }
      }
    }
  ]
}
