--- /dev/null
+++ b/tests/paginate.test.ts
@@ -0,0 +1,10 @@
+import { expect, test } from "bun:test";
+import { paginate } from "../src/paginate.ts";
+
+test("hasNext is true before the last page", () => {
+  expect(paginate([1, 2, 3, 4, 5], 1, 2).hasNext).toBe(true);
+});
+
+test("hasNext is false on the last page", () => {
+  expect(paginate([1, 2, 3, 4, 5], 3, 2).hasNext).toBe(false);
+});
