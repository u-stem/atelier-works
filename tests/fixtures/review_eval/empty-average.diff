+
+export function median(values: readonly number[]): number {
   if (values.length === 0) {
     return 0;
   }
-  return sum(values) / values.length;
+  const sorted = [...values].sort((a, b) => a - b);
+  const mid = Math.floor(sorted.length / 2);
+  if (sorted.length % 2 === 1) {
+    return sorted[mid] ?? 0;
+  }
+  return ((sorted[mid - 1] ?? 0) + (sorted[mid] ?? 0)) / 2;
 }
diff --git a/tests/stats.test.ts b/tests/stats.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/stats.test.ts
@@ -0,0 +1,14 @@
+import { expect, test } from "bun:test";
+import { average, median } from "../src/stats.ts";
+
+test("average of several values is their mean", () => {
+  expect(average([2, 4, 6])).toBe(4);
+});
+
+test("median of an odd count is the middle value", () => {
+  expect(median([3, 1, 2])).toBe(2);
+});
+
+test("median of an even count is the mean of the middle two", () => {
+  expect(median([4, 1, 3, 2])).toBe(2.5);
+});
