+import { expect, test } from "bun:test";
+import { type Db, findUsersByName, type UserRow } from "../src/users.ts";
+
+test("findUsersByName returns the rows the database returns", async () => {
+  const rows: UserRow[] = [{ id: 1, name: "ann", email: "ann@example.invalid" }];
+  const db: Db = { query: async () => rows };
+  expect(await findUsersByName(db, "ann")).toEqual(rows);
+});
