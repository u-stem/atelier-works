node_modules/
console/dist/
# 末尾にスラッシュを付けない。git worktreeに張る`.wmill`のシンボリックリンクも除外するため。
.wmill
infra/.env
infra/secrets.env
.env
.env.*
.envrc
*.pem
*.key
.claude/*.jsonl
.claude/settings.local.json
*.local.*
mise.local.toml
.mise.local.toml
mise.*.local.toml
.DS_Store

# *.local.* above also matches this on-purpose committed template; keep it tracked.
!mise.local.toml.example

# Agent worktrees (Claude Code isolation), never part of the repo
.claude/worktrees/

# Python bytecode (e.g. from running vendored skill scripts)
__pycache__/
console/.cache/
# ブラウザ検査(Playwright)のレポートと一時の出力
console/playwright-report/
console/test-results/

# Playwright MCPがリポジトリ直下に作る作業ディレクトリ
.playwright-mcp/

# bun test --coverageが作るlcov。検査が読むので、コミットしない
coverage/

.superpowers/
