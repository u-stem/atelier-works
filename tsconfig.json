{
  "extends": "./tsconfig.wmill.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    // "paths" here replaces (does not merge with) tsconfig.wmill.json's own
    // "paths", so its /f/* and /u/* entries are repeated. The windmill-
    // client@* entry lets `tsc`/`bun test` resolve the Windmill-specific
    // pinned-version import form (.claude/skills/windmill-script/SKILL.md:
    // `import * as wmill from "windmill-client@1.817.0"`, matching the
    // deployed server's version) against the single installed
    // node_modules/windmill-client package — Windmill's own bundler
    // resolves this specifier server-side; local tooling needs the mapping.
    "paths": {
      "/f/*": ["./f/*"],
      "/u/*": ["./u/*"],
      "windmill-client@*": ["./node_modules/windmill-client"]
    }
  },
  "include": [
    "f/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "infra/console_fetcher/**/*.ts",
    "rt.d.ts"
  ],
  // f/factory/factory_console__raw_app/** (M8) is excluded: it is a
  // structurally separate frontend package (its own package.json — react /
  // react-dom / @types — installed into its own node_modules, bundled by
  // Windmill's own esbuild pipeline via `wmill app dev`/`wmill app bundle`,
  // not by this repo's bun.lock), and its code imports `./wmill` /
  // `../wmill`, a binding Windmill generates/virtualizes at bundle time —
  // not a module this root tsconfig's `moduleResolution` can ever resolve.
  // Verified instead via `wmill app lint` / `wmill app bundle` (a real
  // esbuild build) and biome (style/lint, which needs no module
  // resolution) — see the M8 implementer's final report for the full
  // reasoning.
  "exclude": ["f/factory/factory_console__raw_app/**"]
}
