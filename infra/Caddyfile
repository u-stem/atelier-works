# /console/*の応答だけに付けるヘッダー。404とfallbackにも付ける(handle_errorsでも使う)。
# script-srcは/console/assets/に絞る。CSPのパスにはオリジンが要るので、ブラウザが使った
# オリジン(scheme://host:port)をplaceholderで入れる。
(console_headers) {
        header {
                Content-Security-Policy "default-src 'self'; script-src {http.request.scheme}://{http.request.hostport}/console/assets/; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-src 'self'; frame-ancestors 'none'; worker-src 'none'"
                Content-Security-Policy-Report-Only "require-trusted-types-for 'script'"
                X-Content-Type-Options "nosniff"
                Referrer-Policy "same-origin"
                X-Frame-Options "DENY"
                Cross-Origin-Opener-Policy "same-origin"
        }
}

# draw.ioの図を描くページ(/console/drawio.html)だけに付けるヘッダー。
# 不透明なオリジンのsandbox iframeの中で、同梱のビューアが図のXMLを描く。
# 外への取得は、scriptも含めてすべて拒否する。frame-ancestorsは、Console自身のページからの埋め込みだけを許す。
# sandboxの文書は不透明なオリジンになり、'self'に一致しないので、script-srcと同じく、明示のオリジンで書く。
# sandboxは、親のiframeを経ずに直接開かれても、不透明なオリジンで動かすためである。
# scriptは/console/drawio/の同梱のファイル(ビューアと受け口)だけにする。
# Console本体のCSPは/console/assets/しか許さないので、本体のページからは、このscriptを読めない。
# 本体にHTMLが注入されても、信頼されたオリジンでビューアを動かす足場にならないようにするためである。
# 不透明なオリジンでは'self'が使えないので、console_headersと同じく、ブラウザが使ったオリジンをplaceholderで入れる。
(drawio_headers) {
        header {
                Content-Security-Policy "default-src 'none'; script-src {http.request.scheme}://{http.request.hostport}/console/drawio/; style-src 'unsafe-inline'; img-src data:; font-src data:; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors {http.request.scheme}://{http.request.hostport}; sandbox allow-scripts"
                X-Content-Type-Options "nosniff"
                Referrer-Policy "no-referrer"
                # frame-ancestorsを解釈するブラウザでは、そちらが優先される。これは、解釈しない古いブラウザ向けの備えである。
                X-Frame-Options "SAMEORIGIN"
        }
}

# CSPはパスの`%2f`を区切りとみなさないが、Caddyは区切りに戻してから振り分ける。
# `/console/assets/..%2f...`がscript-srcを通ったまま別のファイルを指さないよう、
# 生のパスに符号化した区切り(`%2f`と`%5c`)があれば400にする。
(console_reject_encoded_separator) {
        @encoded_separator expression `{http.request.orig_uri}.matches("(?i)^[^?]*%(2f|5c)")`
        error @encoded_separator 400
}

{$BASE_URL} {
        # `ADDRESS`が未設定なら、すべてのインターフェース(IPv4とIPv6)で待ち受ける。
        # 値が空の`bind {$ADDRESS}`だと、Caddy 2.9以降はこのサイト全体を捨てる。
        # :25のlayer4のリスナーは動いたまま、HTTPのプロキシだけが黙って止まる。
        bind {$ADDRESS:0.0.0.0 ::}

        # 元のパス(パーセント符号を戻しただけで正規化していないもの)が/consoleか/console/で
        # 始まる要求。CSPは符号を戻してから比べるので(`/%63onsole/`も`/console/`に合う)、
        # 生のURIではなくこれで判定する。handle_errorsでもConsoleの応答の判定に使う。
        @console_raw expression `{http.request.orig_uri.path}.matches("(?i)^/+console(/|$)")`

        # 追加のサービス: LSP、Multiplayer、Debugger(`windmill_extra`のゲートウェイ)。
        @extra path /ws/* /ws_mp/* /ws_debug/*

        # 他のサイト(別のポートのlocalhostを含む)から、運用者のCookieでAPIを呼ばせない。
        # Windmillのフロントエンドからの要求にはブラウザがSec-Fetch-Site: same-originを付け、
        # CLIはこのヘッダーを送らない。ブラウザがこのヘッダーを送るのはlocalhostかHTTPSのときだけなので、
        # WM_BINDを外向きのHTTPにするとこの防御は効かない(docs/security.mdを参照)。
        # /ws/*などwindmill_extraの経路には効かない。
        @cross_site_api {
                path /api/*
                header Sec-Fetch-Site cross-site
                header Sec-Fetch-Site same-site
        }

        # Sec-Fetch-Siteを送らない古いブラウザでも、他のサイトからAPIを呼ばせない。
        # Originがあり、ブラウザが開いたホスト名とポートのオリジンと違う要求を止める。
        # スキームは、httpとhttpsのどちらも許す(前段でTLSを終端する公開に備える)。
        # 前段のプロキシは、ブラウザが使ったHostを保つこと。
        # Originを送らないCLIと、同じオリジンのGETは通す。Originがnullの要求(sandboxのiframeなど)は止める。
        # 許可するホストを固定の一覧にすると、WM_HTTP_PORTを変えたときに黙って壊れる。
        @cross_origin_api {
                path /api/*
                expression `{http.request.header.Origin} != "" && {http.request.header.Origin} != "http://" + {http.request.hostport} && {http.request.header.Origin} != "https://" + {http.request.hostport}`
        }

        # GETなのに副作用のあるAPIは、fetchとXHR(Sec-Fetch-Destがempty)からしか呼ばせない。
        # 同じオリジンの<img>やリンクは、Sec-Fetch-Site: same-originでOriginも付かず、
        # 上の2つの規則を通り抜けて、Cookieの持ち主の権限でジョブを起動できるためである。
        # ジョブを起動するrun_wait_resultとrun_and_stream、Slack/Teamsへ送るapproval、S3のファイルを動かすmove_s3_fileを止める。
        # 作業スペースの部分は`/`をまたいで一致させ、`/`の重なりも許す。余分に止めても害は無い。
        # <a download>はSec-Fetch-Destがemptyでも、Sec-Fetch-Modeがnavigateになるので、これも止める。
        # Sec-Fetch-Destが無い古いブラウザやHTTPで公開したブラウザは、Cookieを持つときだけ止める。
        # CLIはSec-Fetch-*もCookieも送らないので通る。
        # 署名付きの承認リンク(jobs_u/resume、jobs_u/cancel)はメールから開くので、対象にしない。
        @side_effect_get_api {
                method GET HEAD
                path_regexp (?i)^/+api/+w/.+/(jobs/+(run_wait_result|run_and_stream|slack_approval|teams_approval)|job_helpers/+move_s3_file)(/|$)
                expression `({http.request.header.Sec-Fetch-Dest} != "empty" && ({http.request.header.Sec-Fetch-Dest} != "" || {http.request.header.Cookie} != "")) || {http.request.header.Sec-Fetch-Mode} == "navigate"`
        }

        # ページの移動(navigate)で送られる書き込みを止める。
        # 同じオリジンに注入された<form method=post>は、Sec-Fetch-Site: same-originでOriginも一致するので、
        # 上の規則を通り抜ける。ConsoleとWindmillのUIのAPI呼び出しはfetchで、Sec-Fetch-Modeはcorsかsame-originになる。
        # GETとHEADは止めない。ナビゲーションで開く読み取りの導線(ダウンロード、OAuth、署名付きの承認リンク)があるためで、
        # 副作用のあるGETは上の規則が止める。
        # Sec-Fetch-Modeが無い古いブラウザやHTTPで公開したブラウザは、止めない。
        # 止めるとfetchの書き込みも巻き込み、UIが動かなくなる。
        @navigate_write_api {
                path /api/*
                not {
                        method GET HEAD
                }
                header Sec-Fetch-Mode navigate
                header Sec-Fetch-Mode nested-navigate
        }

        # Caddyはhandleをmatcherの種類で並べ替えるので、routeで書いた順に評価させる。
        # Consoleの経路と@console_rawを、どのreverse_proxyよりも先に置く。
        route {
                handle /console {
                        import console_headers
                        # ?approval=<id>などのクエリを保つ。クエリが無いときは?を付けない。
                        redir * /console/{?query} 308
                }

                # console_fetcherの状態。開いたままのタブが、版の取り下げを確かめるために読む。
                # ボリュームの他のファイル(pin、revoked.json、history.jsonなど)は配信しない。
                # ファイルが無ければ404にする(handle_errorsが返す)。
                handle /console/status.json {
                        import console_headers
                        import console_reject_encoded_separator
                        rewrite * /status.json
                        root * /srv/console
                        header Cache-Control "no-store"
                        file_server
                }

                # Consoleの共有のassets。ハッシュ付きの名前なので長期のキャッシュにする。
                # 無いファイルはindex.htmlに落とさず404にする(handle_errorsが返す)。
                handle_path /console/assets/* {
                        import console_headers
                        import console_reject_encoded_separator
                        root * /srv/console/assets
                        header Cache-Control "public, max-age=31536000, immutable"
                        file_server
                }

                # draw.ioのビューアと受け口のscript。ハッシュ付きの名前なので長期のキャッシュにする。
                # 今の版(current)のdrawio/を返し、無いファイルは404にする(handle_errorsが返す)。
                # Consoleの本体より先に置く。Consoleのヘッダーは付けず、drawio_headersを付ける。
                handle_path /console/drawio/* {
                        import drawio_headers
                        import console_reject_encoded_separator
                        root * /srv/console/current/drawio
                        header Cache-Control "public, max-age=31536000, immutable"
                        file_server
                }

                # draw.ioの図を描くページ。Consoleの本体より先に置き、別のヘッダー(drawio_headers)を付ける。
                # 今の版(current)のdrawio.htmlを返す。無ければ404にする(handle_errorsが返す)。
                handle /console/drawio.html {
                        import drawio_headers
                        import console_reject_encoded_separator
                        rewrite * /drawio.html
                        root * /srv/console/current
                        header Cache-Control "no-cache"
                        file_server
                }

                # Consoleの本体。今の版(current)を返し、無いパスはSPAのindex.htmlに落とす。
                # index.htmlは毎回確かめさせる(付け替えの後、すぐ新しい版を読ませるため)。
                # draw.ioのページとscriptは、drawio_headers(sandbox付き)でしか返さない。
                # 区切りを重ねた要求などでここに落ちても、Consoleのヘッダー(sandboxなし)では返さず、404にする。
                handle_path /console/* {
                        @drawio path /drawio.html /drawio.html/* /drawio /drawio/*
                        error @drawio 404
                        import console_headers
                        import console_reject_encoded_separator
                        root * /srv/console/current
                        header Cache-Control "no-cache"
                        try_files {path} /index.html
                        file_server
                }

                # 元のパスが/console/で始まるのに上のConsoleの経路に入らなかった要求
                # (`/console/..%2fws/...`のようにCaddyの正規化でConsoleの外に出たもの)は、
                # どの転送先にも渡さず404にする。
                handle @console_raw {
                        error 404
                }

                handle @cross_site_api {
                        respond 403
                }

                handle @cross_origin_api {
                        respond 403
                }

                handle @side_effect_get_api {
                        respond 403
                }

                handle @navigate_write_api {
                        respond 403
                }

                handle @extra {
                        reverse_proxy http://windmill_extra:3000
                }

                # 検索インデクサ。Enterprise Edition用(windmill_indexer:8002)
                # reverse_proxy /api/srch/* http://windmill_indexer:8002

                # 既定の転送先: Windmillのサーバー
                handle {
                        reverse_proxy http://windmill_server:8000
                }
        }

        # Consoleのエラー(無いassets、currentがまだ無いとき、符号化した区切り、上の404)にも
        # Consoleのヘッダーを付ける。Console以外のエラーはCaddyの既定の応答にする。
        handle_errors {
                handle @console_raw {
                        import console_headers
                        header Cache-Control "no-store"
                        respond "{err.status_code} {err.status_text}" {err.status_code}
                }
        }

        # 独自の証明書でTLSを使う場合
        # tls /certs/cert.pem /certs/key.pem
}
