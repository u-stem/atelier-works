# mise.local.toml.example
#
# 秘密値のキーの一覧。値を入れるのは人で、Claudeは入れない。
# mise.local.tomlはgitの管理外で、doctor.shが`git check-ignore`で確かめる。
#
# 値の投入コマンド(zshとbash)は docs/setup.md の「秘密値を投入する」を参照する。
# 資格情報の作り方(PAT、OAuthトークン、Webhook)は docs/security.md を参照する。

[env]
# ローカルのPostgresのパスワード。任意の強い文字列にする。
DB_PASSWORD = ""

# Windmillの管理者アカウントのメールアドレス。bootstrapがこのアドレスでログインする。
WM_ADMIN_EMAIL = "admin@windmill.dev"

# bootstrapが設定するWindmillの管理者パスワード。"changeme"は使えない。16文字以上にする。
WM_ADMIN_PASSWORD = ""

# GitHubのfine-grained personal access token。権限の設定は docs/security.md に従う。
GITHUB_TOKEN = ""

# Claude CodeのOAuthトークン。ホストで`claude setup-token`を実行して作る。
CLAUDE_CODE_OAUTH_TOKEN = ""

# 通知先のDiscordのWebhook URL。
DISCORD_WEBHOOK_URL = ""

# Console の成果物(CI の artifact)を取り込む console_fetcher 専用の
# fine-grained personal access token。このリポジトリだけを対象にする。
# GITHUB_TOKEN(Factory の広い権限の PAT)は流用せず、console_fetcher の
# コンテナだけに渡す。
# 手順: GitHub 右上のアイコン → Settings → Developer settings →
# Personal access tokens → Fine-grained tokens → Generate new token。
#   - Token name: atelier-works-console-fetcher
#   - Description: Factory Console fetcher (read CI artifacts)
#   - Resource owner: このリポジトリの所有者
#   - Expiration: Custom で 1 年後(最長)。期限切れは console_fetcher の
#     ログと status.json に auth_failed として出る
#   - Repository access: Only select repositories → このリポジトリだけ
#   - Repository permissions:
#       Actions = Read-only
#       Metadata = Read-only(自動で付与される)
#       ほかはすべて No access
#   - Account permissions: すべて No access
#   read -rs 'v?CONSOLE_GITHUB_TOKEN: ' && mise set -E local CONSOLE_GITHUB_TOKEN="$v"; unset v
CONSOLE_GITHUB_TOKEN = ""
