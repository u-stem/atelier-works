{
  "permissions": {
    "allow": [
      "Bash(docker compose -f infra/docker-compose.yml ps:*)",
      "Bash(docker compose -f infra/docker-compose.yml logs:*)",
      "Bash(bun run scripts/:*)",
      "Bash(bun test:*)",
      "Bash(mise run check:*)",
      "Bash(mise run lint:*)",
      "Bash(mise run typecheck:*)",
      "Bash(mise run test:*)",
      "Bash(mise run doctor:*)",
      "Bash(mise run push:dry:*)",
      "Bash(mise run logs:*)",
      "Bash(mise run setup:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(wmill lint:*)",
      "Bash(wmill sync push --dry-run:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./infra/.env)",
      "Read(./infra/secrets.env)",
      "Read(./**/.env)",
      "Read(**/mise.local.toml)",
      "Edit(**/mise.local.toml)",
      "Read(**/.mise.local.toml)",
      "Edit(**/.mise.local.toml)",
      "Read(**/mise.*.local.toml)",
      "Edit(**/mise.*.local.toml)",
      "Read(**/.wmill/**/remotes.ndjson)",
      "Edit(**/.wmill/**/remotes.ndjson)",
      "Bash(mise env:*)",
      "Bash(mise env)",
      "Bash(mise set)",
      "Bash(mise e)",
      "Bash(mise e:*)",
      "Bash(mise ev)",
      "Bash(mise env-vars)",
      "Bash(mise config:*)",
      "Bash(mise cfg:*)",
      "Bash(mise toml:*)",
      "Bash(mise exec -- env:*)",
      "Bash(mise exec -- printenv:*)",
      "Bash(mise x -- env:*)",
      "Bash(mise x -- printenv:*)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(cat mise.local.toml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '[ -f \"$1\" ] || { echo \"claude hook: launcher not found at $1, so the command was not checked; allowing the tool call\" >&2; echo \"{\\\"systemMessage\\\":\\\"The bash guard hook did not run (the launcher was not found), so the command was not checked; only the deny rules of .claude/settings.json apply.\\\"}\"; exit 0; }; exec /bin/sh \"$@\"' _ \"${CLAUDE_PROJECT_DIR}/scripts/claude-hooks/run.sh\" bash-guard",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
